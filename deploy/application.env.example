# 将此文件复制到deploy/application.env目录下

# Shared application settings
OCEAN_HOME=.
OCEAN_ADMIN_VERSION=1.0.0
APP_PORT=8090
JAVA_TOOL_OPTIONS=

# PostgreSQL
POSTGRES_DB=ocean_admin
POSTGRES_BIND_ADDRESS=0.0.0.0
POSTGRES_PORT=5433
DB_URL=jdbc:postgresql://127.0.0.1:5433/ocean_admin
DB_USERNAME=ocean_admin
DB_PASSWORD=ocean_admin
FLYWAY_ENABLED=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_BIND_ADDRESS=0.0.0.0
REDIS_PORT=6381
REDIS_PASSWORD=123456
REDIS_DB=0

# GIS data and publication
GIS_UPLOAD_BASE_PATH=gis/uploads
GIS_PROCESSING_BASE_PATH=gis/processing
GIS_PROCESSING_WORKSPACE_DEFAULT=gis/workspaces/default
GIS_IMAGERY_CACHE_PATH=imagery/cache
GIS_PUBLIC_BASE_URL=http://127.0.0.1:8090

# 独立 Java 读取进程使用 GDAL 3.13.0 Java/JNI；Maven JAR 不包含原生动态库。
# 容器已配套 JNI、GDAL 与 PROJ；Windows 直接启动时填写同版本 JNI 所在目录，
# 并将 GDAL 及其依赖 DLL 目录加入 PATH，配置 GDAL_DATA 和 PROJ_DATA。
# DWG 仅支持开源 CAD 驱动实际识别的版本，镜像不包含 ODA 驱动。
GIS_GDAL_WORKER_MAX_HEAP=1g
GIS_GDAL_NATIVE_LIBRARY_PATH=
GIS_GDAL_PROCESS_TIMEOUT=30m
GIS_GDAL_MAX_LOG_BYTES=65536
GIS_GDAL_MAX_METADATA_BYTES=16777216
GIS_GDAL_MAX_OUTPUT_BYTES=107374182400

# Terrain engine. Leave the JAR path empty to use the deployment script default.
GIS_TERRAIN_MAGO_ENABLED=true
GIS_TERRAIN_MAGO_JAR_PATH=
GIS_TERRAIN_MAGO_MAX_HEAP=8g

