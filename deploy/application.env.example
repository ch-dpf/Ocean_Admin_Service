# 将此文件复制到deploy/application.env目录下，并替换所有“change-me”占位符的值。

# Shared application settings
APP_PORT=8090
JAVA_TOOL_OPTIONS=

# PostgreSQL
POSTGRES_DB=ocean_admin
DB_URL=jdbc:postgresql://127.0.0.1:5432/ocean_admin
DB_USERNAME=ocean_admin
DB_PASSWORD=change-me
FLYWAY_ENABLED=true

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# GIS data and publication
GIS_UPLOAD_BASE_PATH=gis/uploads
GIS_PROCESSING_BASE_PATH=gis/processing
GIS_PROCESSING_WORKSPACE_DEFAULT=gis/workspaces/default
GIS_IMAGERY_CACHE_PATH=imagery/cache
GIS_PUBLIC_BASE_URL=http://127.0.0.1:8090

# Terrain engine. Leave the JAR path empty to use the deployment script default.
GIS_TERRAIN_MAGO_ENABLED=true
GIS_TERRAIN_MAGO_JAR_PATH=
GIS_TERRAIN_MAGO_MAX_HEAP=32g

